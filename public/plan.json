  "kneeCheck": {
    "askBeforeEverySession": true,
    "questions": [
      {
        "id": "swelling",
        "text": "Schwellung?",
        "options": [
          "keine",
          "leicht",
          "deutlich"
        ]
      },
      {
        "id": "pain",
        "text": "Schmerz (0–10)?",
        "type": "scale",
        "min": 0,
        "max": 10
      },
      {
        "id": "stiffness",
        "text": "Auffällige Morgensteifigkeit der Sehne?",
        "options": [
          "nein",
          "ja"
        ]
      },
      {
        "id": "givingWay48h",
        "text": "Wegknicken in den letzten 48 Stunden?",
        "options": [
          "nein",
          "ja"
        ]
      },
      {
        "id": "locking",
        "text": "Blockade oder Einklemmen?",
        "options": [
          "nein",
          "ja"
        ]
      }
    ],
    "derive": {
      "red": "swelling == 'deutlich' ODER pain >= 5 ODER givingWay48h == 'ja' ODER locking == 'ja'",
      "yellow": "sonst, wenn swelling == 'leicht' ODER pain in 3..4 ODER stiffness == 'ja'",
      "green": "sonst (keine Schwellung, Schmerz <= 2)"
    },
    "green": {
      "action": "Plan wie geschrieben."
    },
    "yellow": {
      "action": "Schonmodus: Sprünge, Step-downs und Ausfallschritte streichen. Lasten an Beingeräten, Kniebeuge und Kreuzheben minus 20 %. Isometrie erlaubt.",
      "loadFactor": 0.8,
      "countsForProgression": false,
      "countsForSymmetry": false,
      "pointsPenalty": false
    },
    "red": {
      "action": "Kein Beintraining, nur Oberkörper. Physio informieren. Bei Blockade oder Einklemmen sofort den Operateur kontaktieren.",
      "lowerSessions": "suspend",
      "upperSessions": "skipKneeLoadedItems",
      "cardio": "skip",
      "mobility": "allowed",
      "suspendedCountsAsFulfilled": true
    },
    "events": {
      "givingWay": "Jedes Wegknicken wird als Ereignis gespeichert. Hinweis: dem Operateur melden (Meniskusnaht).",
      "locking": "Als Ereignis speichern. Hinweis: sofort den Operateur kontaktieren."
    }
  },
  "progression": {
    "e1rmFormula": "weightKg * (1 + (reps + rirUsed) / 30), nur Sätze mit reps <= 15; rirUsed = geloggter RIR, sonst unterer Wert von targetRIR",
    "double": "Wenn in der letzten regulären Einheit alle Sätze die obere Wiederholungszahl erreicht haben (bei Ziel-RIR): nächste Einheit +incrementKg, Wiederholungen ab unterem Wert. Sonst gleiche Last, Ziel +1 Wiederholung.",
    "technique": "Wie double, aber höchstens +5 kg pro Woche und nur, wenn die letzte Einheit GRÜN war.",
    "manual": "Keine automatische Empfehlung, letzte Werte vorbelegen.",
    "unilateral": "Jede Seite hat ihre eigene Progression.",
    "userCanOverrideIncrement": true
  },
