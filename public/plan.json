  "legend": {
    "tempo": "Sekunden: Ablassen – Halten – Heben. 5-2-2 = 5 s ab, 2 s halten, 2 s hoch (von der Physio bestätigt).",
    "rir": "Wiederholungen in Reserve am Satzende.",
    "unilateral": "Einbeinig/einseitig. Rechts beginnt, beide Seiten werden getrennt protokolliert.",
    "source": "physio = Übung aus dem Plan der Physiotherapeutin, coach = ergänzt."
  },
  "globalRules": {
    "maxKneeFlexionUnderLoadDeg": 90,
    "legsNeverToFailure": true,
    "forbiddenUntilSurgery": [
      "Laufen",
      "einbeinige Sprünge",
      "Drehungen und Richtungswechsel auf dem belasteten Bein",
      "Brustbeinschlag beim Schwimmen",
      "Positionen, die das gebeugte Knie verdrehen (z. B. 90/90-Sitz)"
    ],
    "painRule": "Bis 3/10 an der Patellasehne ist in Ordnung, wenn es binnen 24 Stunden abklingt. Stechender Schmerz im Gelenkspalt: Satz sofort abbrechen.",
    "jointRule": "Engpass ist das Gelenk, nicht der Muskel: Ist das Knie am Folgetag dicker, war die Einheit zu viel."
  },
